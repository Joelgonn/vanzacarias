# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA files
public/sw.js
public/sw.js.map
.vercel
.env*.local

# TTS-INTEGRATION-007 — bundle gerado do Worker do Browser Runtime (build)
/public/tts/

# TTS-CAP-002 — assets TTS locais do Capacitor/Android (copiados no sync;
# gitignored → NÃO vão ao deploy web/Vercel; Web/PWA intactos)
/public/assets/tts/
