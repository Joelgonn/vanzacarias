<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splashBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ÍCONE ORIGINAL - public/icon-512x512.png via drawable/splash_logo -->
        <!-- Correção clipping: Frame 220dp com ícone 184dp + clipChildren false, margem 18dp para pulso 1.04 sem corte -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/splash_symbol"
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_gravity="center"
                android:clipToPadding="false"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_logo" />

        </FrameLayout>

        <!-- Identidade textual: Vanusa Zacarias NUTRI (1500-2050) -->
        <LinearLayout
            android:id="@+id/brand_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alpha="0"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brand_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:text="Vanusa Zacarias"
                android:textColor="@color/brandPrimary"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/brand_nutri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.35"
                android:text="NUTRI"
                android:textColor="@color/brandNutri"
                android:textSize="14sp" />

            <View
                android:layout_width="64dp"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/brandDivider" />

        </LinearLayout>

        <!-- Slogan (2050-2350) -->
        <TextView
            android:id="@+id/brand_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.18"
            android:text="SAÚDE HOJE, MAIS VIDA SEMPRE"
            android:textColor="@color/brandSlogan"
            android:textSize="10sp" />

    </LinearLayout>

</FrameLayout>
